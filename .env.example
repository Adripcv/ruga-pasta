# 🔐 Copier en `.env` puis adapter. `.env` n'est jamais committé.

# --- Site ---------------------------------------------------------------
# Domaine public du site, sans slash final. Sert aux balises SEO (canonical,
# og:image, JSON-LD) et au sitemap.
SITE_URL=https://ruga-pasta.vercel.app

# --- Supabase (click & collect) ------------------------------------------
# Projet Supabase → Settings → API.
# La clé `anon` est publique par design (RLS deny-all : elle ne donne accès à
# rien). La clé `service_role` est SECRÈTE : uniquement côté serveur (Vercel).
SUPABASE_URL=https://TON-PROJET.supabase.co
SUPABASE_ANON_KEY=colle-ici-la-cle-anon-publique
SUPABASE_SERVICE_ROLE_KEY=colle-ici-la-cle-service-role-secrète

# --- Emails transactionnels (Resend) -------------------------------------
# Optionnel en dev : sans clé, les emails sont simplement sautés (log serveur).
# Gratuit jusqu'à 3 000 emails/mois → resend.com
RESEND_API_KEY=re_...
# Expéditeur affiché. Sur le domaine Vercel, utiliser onboarding@resend.dev.
# Avec un domaine personnalisé vérifié chez Resend : "Ruga Pasta <commande@ruga-pasta.fr>".
RESEND_FROM="Ruga Pasta <onboarding@resend.dev>"

# --- Dashboard gérant (/admin) -------------------------------------------
# Liste des emails autorisés à se connecter, séparés par des virgules.
ADMIN_EMAILS=gerant@ruga-pasta.fr

# En développement local uniquement : laisse le dashboard démonter l'auth
# (aucun email autorisé n'est configuré). NE JAMAIS activer en production :
# en prod, si ADMIN_EMAILS est vide, l'API admin refuse tout (fail-closed).
ADMIN_DEV_UNLOCK=0
